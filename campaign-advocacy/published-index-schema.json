{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.brgsttr.de/campaign-advocacy/published-index-schema.json",
  "title": "BRGSTTR Campaign Advocacy Published Case Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "last_updated", "ordering", "cases"],
  "properties": {
    "schema": {"type": "string"},
    "last_updated": {"type": "string", "format": "date"},
    "ordering": {"type": "string"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id", "public_anchor", "entity_or_brand", "period", "initiative",
          "dimension", "measure_scale", "reference_level", "maturity",
          "status", "publication_state", "last_reviewed"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "public_anchor": {"type": "string", "pattern": "^case-[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "entity_or_brand": {"type": "string", "minLength": 1},
          "period": {"type": "string", "minLength": 1},
          "initiative": {"type": "string", "minLength": 1},
          "dimension": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "brand_stewardship",
                "corporate_governance",
                "leadership",
                "process_or_service_quality",
                "innovation",
                "industry_or_ecosystem_standard"
              ]
            }
          },
          "measure_scale": {
            "enum": ["micro_measure", "feature", "pilot", "programme", "system", "structural_change"]
          },
          "reference_level": {
            "enum": ["internal", "customer_facing", "sectoral", "ecosystem"]
          },
          "maturity": {
            "enum": ["pilot", "active", "scaled", "completed", "historical", "revised"]
          },
          "status": {
            "enum": ["current", "historical", "revised", "no_longer_applicable"]
          },
          "publication_state": {"enum": ["published", "withdrawn"]},
          "last_reviewed": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
