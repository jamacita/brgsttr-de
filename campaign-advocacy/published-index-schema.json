{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.brgsttr.de/campaign-advocacy/published-index-schema.json",
  "title": "BRGSTTR Campaign Advocacy Published Case Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "last_updated",
    "ordering",
    "cases",
    "thematic_order"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "ordering": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "public_anchor",
          "entity_or_brand",
          "period",
          "initiative",
          "dimension",
          "measure_scale",
          "reference_level",
          "maturity",
          "status",
          "publication_state",
          "last_reviewed",
          "case_version",
          "first_published",
          "last_material_revision",
          "review_due",
          "source_last_checked",
          "change_monitoring",
          "primary_theme"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "public_anchor": {
            "type": "string",
            "pattern": "^case-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "entity_or_brand": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "initiative": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "brand_stewardship",
                "corporate_governance",
                "leadership",
                "process_or_service_quality",
                "innovation",
                "voluntary_self_standard",
                "industry_or_ecosystem_standard"
              ]
            }
          },
          "measure_scale": {
            "enum": [
              "micro_measure",
              "feature",
              "pilot",
              "programme",
              "system",
              "structural_change"
            ]
          },
          "reference_level": {
            "enum": [
              "internal",
              "customer_facing",
              "sectoral",
              "ecosystem"
            ]
          },
          "maturity": {
            "enum": [
              "pilot",
              "active",
              "scaled",
              "completed",
              "historical",
              "revised"
            ]
          },
          "status": {
            "enum": [
              "current",
              "historical",
              "revised",
              "no_longer_applicable"
            ]
          },
          "publication_state": {
            "enum": [
              "published",
              "withdrawn"
            ]
          },
          "last_reviewed": {
            "type": "string",
            "format": "date"
          },
          "case_version": {
            "type": "integer",
            "minimum": 1
          },
          "first_published": {
            "type": "string",
            "format": "date"
          },
          "last_material_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_due": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_last_checked": {
            "type": [
              "string",
              "null"
            ]
          },
          "change_monitoring": {
            "enum": [
              "none",
              "periodic",
              "material_change"
            ]
          },
          "primary_theme": {
            "enum": [
              "inclusive_design_accessibility",
              "service_design_customer_autonomy",
              "repairability_longevity_circular_use",
              "brand_stewardship_public_communication",
              "governance_leadership_voluntary_commitments",
              "safety_privacy_open_standards"
            ]
          }
        }
      }
    },
    "thematic_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inclusive_design_accessibility",
          "service_design_customer_autonomy",
          "repairability_longevity_circular_use",
          "brand_stewardship_public_communication",
          "governance_leadership_voluntary_commitments",
          "safety_privacy_open_standards"
        ]
      }
    }
  }
}
